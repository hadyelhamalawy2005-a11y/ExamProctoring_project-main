# Copy to .env.local and adjust. Placeholders only: never put passwords, JWT signing keys or connection strings here.
# Everything prefixed with VITE_ is bundled into the browser code and is therefore public.

# Option 1 (recommended for development): leave VITE_API_BASE_URL empty and let the dev server proxy /api to the
# backend. The value below is the "http" launch profile in src/ExamProctoring.Api/Properties/launchSettings.json
# (dotnet run --project src/ExamProctoring.Api --launch-profile http). It is also the default when the variable is unset.
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://localhost:5168
# Only matters for an https target. Set to true only if Node.js trusts the backend's HTTPS certificate.
VITE_DEV_PROXY_VERIFY_TLS=false

# For the "https" launch profile use this target instead (the browser still talks to the dev server only):
# VITE_DEV_PROXY_TARGET=https://localhost:7046

# Option 2: call the backend directly from the browser. This needs the backend to allow the frontend's origin in
# Cors:WebExamOrigins (currently empty), so it does not work until that backend setting is approved and added.
# VITE_API_BASE_URL=http://localhost:5168
